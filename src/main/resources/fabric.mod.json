{
	"schemaVersion": 1,
	"id": "ezblocks",
	"version": "${version}",
	"name": "EZ Blocks",
	"description": "A better GUI for structure blocks. Search every structure in your world, set the size, and save or place it without leaving the screen.",
	"authors": [
		"zallkyre"
	],
	"contact": {},
	"license": "MIT",
	"icon": "assets/ezblocks/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.ezblocks.EzBlocks"
		],
		"client": [
			"dev.ezblocks.client.EzBlocksClient"
		]
	},
	"mixins": [
		"ezblocks.mixins.json",
		{
			"config": "ezblocks.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
